# Web Scraping Lab
# Objectives:
#   - Download a webpage using the requests module
#   - Scrape all links from a web page
#   - Scrape all image urls from a web page
#   - Scrape data from HTML tables

# --- Imports ---
from bs4 import BeautifulSoup  # helps with web scraping
import requests                # downloads a web page


# --- Scrape www.ibm.com ---
url = "http://www.ibm.com"

# Get the contents of the webpage as text
data = requests.get(url).text

# Create a soup object from the downloaded HTML
soup = BeautifulSoup(data, "html5lib")


# --- Scrape all links ---
# In HTML, a link is represented by the <a> tag
for link in soup.find_all("a"):
    print(link.get("href"))


# --- Scrape all images ---
# In HTML, an image is represented by the <img> tag
for img in soup.find_all("img"):
    print(img.get("src"))


# --- Scrape data from HTML tables ---
# This URL contains an HTML table of colors and color codes
url = (
    "https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/"
    "IBM-DA0321EN-SkillsNetwork/labs/datasets/HTMLColorCodes.html"
)

data = requests.get(url).text
soup = BeautifulSoup(data, "html5lib")

# Find the table in the page (<table> tag)
table = soup.find("table")

# Loop over every row (<tr> tag)
for row in table.find_all("tr"):
    # Get all columns in the row (<td> tag)
    cols = row.find_all("td")

    # Skip rows without enough data cells (e.g. the header row)
    if len(cols) < 4:
        continue

    color_name = cols[2].getText()  # column 3
    color_code = cols[3].getText()  # column 4
    print("{}--->{}".format(color_name, color_code))
